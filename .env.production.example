# Variables de entorno para PRODUCCIÓN (Render)
# Configura estas variables en el dashboard de Render

# ===== MERCADOPAGO =====
# Usa el token de producción que obtuviste de tu cuenta MercadoPago
MERCADOPAGO_ACCESS_TOKEN_TEST=APP_USR-XXXXXXXX-XXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXXX

# ===== BASE DE DATOS POSTGRESQL (NEON) =====
# URL de conexión desde tu dashboard de Neon
DATABASE_URL=postgresql://usuario:contraseña@host-pooler.region.aws.neon.tech/database?sslmode=require&channel_binding=require

# ===== EMAIL (ZOHO) =====
EMAIL_USER=tu_email@capristorezte.com.ar
EMAIL_PASS=tu_contraseña_de_aplicacion_zoho_aqui

# ===== ENTORNO =====
# IMPORTANTE: Debe ser 'production' en Render para activar auto_return
NODE_ENV=production
PORT=3001

# ===== INSTRUCCIONES PARA RENDER =====
# 1. Ve a tu servicio en Render > Environment
# 2. Agrega cada variable EXACTAMENTE como aparece arriba (con tus valores reales)
# 3. NODE_ENV=production es crucial para que funcione el auto_return
# 4. El token de MercadoPago lo obtienes de tu cuenta de MercadoPago > Developers
# 5. La DATABASE_URL la obtienes desde tu dashboard de Neon
# 6. Para EMAIL_PASS usa una contraseña de aplicación de Zoho, no tu contraseña normal
