# ===============================
# CONFIGURACIÓN DE CAPRI STORE
# ===============================
# Copia este archivo como .env y configura tus valores reales

# ===============================
# INFORMACIÓN DE CONTACTO
# ===============================
# Número de WhatsApp para contacto y notificaciones (formato: 5493415123456)
ADMIN_WHATSAPP=5493415123456

# Usuario de Instagram (sin @)
ADMIN_INSTAGRAM=capri_store_oficial

# Email de contacto
ADMIN_EMAIL=contacto@capristore.com.ar

# ===============================
# WHATSAPP CLOUD API (OPCIONAL)
# ===============================
# Cambia a true para usar la API oficial en lugar del cliente web
USE_WHATSAPP_API=false
# ID del número provisto por Meta (phone_number_id)
WHATSAPP_API_PHONE_NUMBER_ID=
# Token de acceso permanente o temporal generado en Meta
WHATSAPP_API_TOKEN=
# Nombre de la plantilla aprobada en Meta (ej: order_management_1)
WHATSAPP_API_TEMPLATE_NAME=
# Idioma de la plantilla (ej: es o es_AR)
WHATSAPP_API_TEMPLATE_LANGUAGE=es
# Personaliza versión/base solo si es necesario
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Timeout en milisegundos para las solicitudes (opcional)
WHATSAPP_API_TIMEOUT_MS=15000

# ===============================
# MERCADO PAGO
# ===============================
# Token de acceso de MercadoPago (usa TEST- para pruebas, sin prefijo para producción)
MERCADOPAGO_ACCESS_TOKEN=TU_ACCESS_TOKEN_AQUI
MERCADOPAGO_ACCESS_TOKEN_TEST=TEST-TU_ACCESS_TOKEN_DE_PRUEBA_AQUI

# ===============================
# BASE DE DATOS
# ===============================
# URL de conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/capristore

# ===============================
# PANEL ADMIN (Fase 1)
# ===============================
# Usuario fijo del panel admin
ADMIN_USERNAME=admin
# Hash bcrypt de la contraseña. Generarlo con: node scripts/hash-password.js "miPasswordSegura"
ADMIN_PASSWORD_HASH=
# Secreto para firmar los JWT de sesión del admin (usar un valor largo y aleatorio)
JWT_SECRET=
# Duración de la sesión (formato aceptado por jsonwebtoken, ej: 12h, 1d)
JWT_EXPIRES_IN=12h

# ===============================
# CONFIGURACIÓN DEL ENTORNO
# ===============================
# Entorno de ejecución (development, production)
NODE_ENV=production

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3001

# ===============================
# INSTRUCCIONES
# ===============================
# 1. Para INFORMACIÓN DE CONTACTO:
#    - ADMIN_WHATSAPP: Número de WhatsApp con código de país (ejemplo: 5493415123456)
#    - ADMIN_INSTAGRAM: Usuario de Instagram sin @ (ejemplo: capri_store_oficial)
#    - ADMIN_EMAIL: Email para contacto directo (ejemplo: contacto@capristore.com.ar)
#
# 2. Para MERCADO PAGO:
#    - Obtén tus tokens desde https://www.mercadopago.com.ar/developers/
#    - Usa el token TEST para pruebas
#    - Cambia a token de producción cuando esté listo
#
# 3. Para la BASE DE DATOS:
#    - Configura tu conexión PostgreSQL
#    - Asegúrate de que la base tenga las tablas necesarias
#
# 4. Para PRODUCCIÓN:
#    - Configura estas variables en tu plataforma de hosting (Render, Heroku, etc.)
#    - NO subas el archivo .env al repositorio
#
# 5. Para WHATSAPP CLOUD API (OPCIONAL):
#    - Activa USE_WHATSAPP_API únicamente cuando tengas credenciales de Meta
#    - WHATSAPP_API_PHONE_NUMBER_ID y WHATSAPP_API_TOKEN se obtienen en el panel de Meta
#    - Ajusta versión, base URL o timeout solo si Meta lo requiere
#
# 6. Para el PANEL ADMIN:
#    - Generar el hash: node scripts/hash-password.js "miPasswordSegura"
#    - JWT_SECRET: cualquier string largo y aleatorio (ej: openssl rand -hex 32)
#    - No reutilizar la API-key móvil legacy para esto
